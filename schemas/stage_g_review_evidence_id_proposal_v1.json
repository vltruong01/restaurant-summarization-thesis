{
  "type": "object",
  "additionalProperties": false,
  "required": ["business_id", "claims"],
  "properties": {
    "business_id": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "polarity", "support"],
        "properties": {
          "text": {"type": "string"},
          "polarity": {"type": "string", "enum": ["positive", "negative", "mixed"]},
          "support": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["review_marker", "review_id", "evidence_span_ids"],
              "properties": {
                "review_marker": {"type": "string"},
                "review_id": {"type": "string"},
                "evidence_span_ids": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
