{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thesis:stage-i:d053:annotation:1",
  "title": "D-053 researcher source-reference working annotations",
  "description": "Structural schema permits incomplete drafts. The accompanying pure-stdlib semantic validator checks exact source evidence, immutable bindings, confirmation snapshots and strict final readiness. Human flags record provenance, not software-established truth.",
  "type": "object",
  "required": ["schema_version", "stage", "bundle_id", "bindings", "reviewer_id", "candidate_annotations", "units", "business_reviews", "researcher_confirmed_complete", "history"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"const": "D-053"},
    "bundle_id": {"type": "string", "minLength": 1},
    "bindings": {"$ref": "#/$defs/bindings"},
    "reviewer_id": {"type": "string"},
    "candidate_annotations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/candidate"}},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "business_reviews": {"type": "object", "additionalProperties": {"$ref": "#/$defs/business"}},
    "researcher_confirmed_complete": {"type": "boolean"},
    "history": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "nullable_text": {"type": ["string", "null"]},
    "importance": {"enum": [null, "core", "supporting"]},
    "informativeness": {"enum": [null, "useful_specific", "useful_general", "low_information"]},
    "bindings": {
      "type": "object",
      "required": ["case_inputs_sha256", "protocol_sha256", "candidate_sha256", "source_cases_sha256", "evaluation_config_sha256"],
      "properties": {
        "case_inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_cases_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluation_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["support_label", "human_verified", "confirmed_by", "confirmed_at", "importance", "informativeness", "reviewer_notes", "corrected_claim_text", "final_unit_ids", "revision_disposition"],
      "properties": {
        "support_label": {"enum": [null, "supported", "unsupported", "contradicted", "uncertain", "needs_revision"]},
        "human_verified": {"type": "boolean"},
        "confirmed_by": {"$ref": "#/$defs/nullable_text"},
        "confirmed_at": {"$ref": "#/$defs/nullable_text"},
        "importance": {"$ref": "#/$defs/importance"},
        "informativeness": {"$ref": "#/$defs/informativeness"},
        "reviewer_notes": {"type": "string"},
        "corrected_claim_text": {"type": "string"},
        "final_unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "revision_disposition": {"enum": [null, "pending_unresolved", "resolved_with_confirmed_units", "excluded_from_reference"]}
      },
      "additionalProperties": false
    },
    "business": {
      "type": "object",
      "required": ["human_verified", "positive_negative_and_specificity_checked", "confirmed_by", "confirmed_at", "notes", "missing_information_notes"],
      "properties": {
        "human_verified": {"type": "boolean"},
        "positive_negative_and_specificity_checked": {"type": "boolean"},
        "confirmed_by": {"$ref": "#/$defs/nullable_text"},
        "confirmed_at": {"$ref": "#/$defs/nullable_text"},
        "notes": {"type": "string"},
        "missing_information_notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object", "required": ["marker", "quote"],
      "properties": {
        "marker": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "review_id": {"$ref": "#/$defs/nullable_text"},
        "photo_id": {"$ref": "#/$defs/nullable_text"}
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "allOf": [{"if": {"properties": {"domain": {"const": "visual"}}, "required": ["domain"]}, "then": {"properties": {"polarity": {"type": "null"}}}}],
      "required": ["unit_id", "business_id", "domain", "text", "support_status", "evidence", "importance", "informativeness", "aspect", "restaurant_specific", "human_verified", "confirmed_by", "confirmed_at", "atomicity_confirmed", "evidence_confirmed", "visual_photo_confirmed", "provenance"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "business_id": {"type": "string", "minLength": 1},
        "domain": {"enum": ["review", "visual"]},
        "text": {"type": "string"},
        "support_status": {"enum": [null, "supported"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "importance": {"$ref": "#/$defs/importance"},
        "informativeness": {"$ref": "#/$defs/informativeness"},
        "aspect": {"type": ["string", "null"]},
        "restaurant_specific": {"type": ["boolean", "null"]},
        "polarity": {"enum": [null, "positive", "negative", "mixed", "neutral"]},
        "human_verified": {"type": "boolean"},
        "confirmed_by": {"$ref": "#/$defs/nullable_text"},
        "confirmed_at": {"$ref": "#/$defs/nullable_text"},
        "atomicity_confirmed": {"type": "boolean"},
        "evidence_confirmed": {"type": "boolean"},
        "visual_photo_confirmed": {"type": "boolean"},
        "parent_candidate_id": {"$ref": "#/$defs/nullable_text"},
        "provenance": {
          "type": "object", "required": ["origin", "parent_candidate_id"],
          "properties": {
            "origin": {"enum": ["candidate_split", "researcher_added"]},
            "parent_candidate_id": {"$ref": "#/$defs/nullable_text"}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
